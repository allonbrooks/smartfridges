/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  background-color: #f5f5f5;
  color: #333;
  box-sizing: border-box;
}

/* 状态色 */
.status-green { color: #07c160; }
.status-yellow { color: #faad14; }
.status-red { color: #f5222d; }

.bg-green { background-color: #07c160; }
.bg-yellow { background-color: #faad14; }
.bg-red { background-color: #f5222d; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 30rpx;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}