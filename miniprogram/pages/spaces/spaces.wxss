/* 空间页面 */
.page { padding-bottom: 20rpx; }

.add-btn {
  margin: 20rpx;
  padding: 28rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  color: #07c160;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.space-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 0 20rpx;
}

.space-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.space-type {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.type-cold { background: #e6f7ff; }
.type-frozen { background: #f0f5ff; }
.type-normal { background: #fff7e6; }

.space-icon { font-size: 48rpx; }

.space-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.space-count {
  display: block;
  font-size: 24rpx;
  color: #999;
}