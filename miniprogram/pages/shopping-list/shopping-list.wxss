/* 购物清单页 */
.page { padding-bottom: 20rpx; }

.header-actions {
  display: flex;
  gap: 20rpx;
  margin: 20rpx;
}

.add-btn, .clear-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.add-btn { background: #fff; color: #07c160; }
.clear-btn { background: #fff; color: #f5222d; }

.list { margin: 0 20rpx; }

.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.list-item.checked {
  opacity: 0.5;
}

.list-item.checked .item-name {
  text-decoration: line-through;
  color: #999;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.list-item.checked .checkbox {
  background: #07c160;
  border-color: #07c160;
}

.check-icon { color: #fff; font-size: 24rpx; }

.item-body { flex: 1; }
.item-name { display: block; font-size: 28rpx; }
.item-qty { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

.delete-btn {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #f5222d;
  background: #fff1f0;
  flex-shrink: 0;
  margin-left: 16rpx;
}