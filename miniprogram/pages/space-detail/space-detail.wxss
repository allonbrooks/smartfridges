/* 空间详情页 */
.page { padding-bottom: 20rpx; }

.add-btn {
  margin: 20rpx;
  padding: 28rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  color: #07c160;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.item-list {
  margin: 0 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.item-status {
  width: 8rpx;
  height: 64rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.status-green { background: #07c160; }
.status-yellow { background: #faad14; }
.status-red { background: #f5222d; }

.item-body { flex: 1; min-width: 0; }
.item-name { display: block; font-size: 30rpx; font-weight: 500; margin-bottom: 4rpx; }
.item-detail { display: block; font-size: 24rpx; color: #999; margin-bottom: 4rpx; }
.item-expiry { display: block; font-size: 22rpx; }
.item-calorie { display: block; font-size: 20rpx; color: #faad14; margin-top: 2rpx; }
.item-meta { display: block; font-size: 20rpx; color: #bbb; margin-top: 2rpx; }

.item-actions { display: flex; gap: 8rpx; flex-shrink: 0; margin-left: 16rpx; }
.action { padding: 10rpx 18rpx; border-radius: 30rpx; font-size: 22rpx; white-space: nowrap; }
.edit { background: #f0f5ff; color: #2f54eb; }
.consume { background: #e6f7ff; color: #1890ff; }
.delete { background: #fff1f0; color: #f5222d; }

/* 删除空间按钮 */
.delete-space {
  margin: 40rpx 20rpx 20rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 2rpx solid #ffccc7;
  color: #f5222d;
  font-size: 26rpx;
}

/* 编辑弹窗样式 */
.modal-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.btn-danger {
  background: #f5222d;
}