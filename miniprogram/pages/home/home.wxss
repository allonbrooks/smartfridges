/* 首页样式 */
.page {
  padding-bottom: 20rpx;
}

/* 状态概要 */
.summary-bar {
  display: flex;
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.summary-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.summary-item + .summary-item::after {
  content: '';
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 1px;
  background: #eee;
}

.summary-item .num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
}

.summary-item .label {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.summary-item.safe .num { color: #07c160; }
.summary-item.expiring .num { color: #faad14; }
.summary-item.expired .num { color: #f5222d; }

/* 快捷录入 */
.quick-actions {
  display: flex;
  margin: 0 20rpx 20rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.action-btn .icon {
  font-size: 40rpx;
}

/* 标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 20rpx 12rpx;
  color: #666;
}

/* 物品列表 */
.item-list {
  margin: 0 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.item-status {
  width: 8rpx;
  height: 64rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.status-green { background: #07c160; }
.status-yellow { background: #faad14; }
.status-red { background: #f5222d; }

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.item-expiry {
  display: block;
  font-size: 22rpx;
}

.item-meta {
  display: block;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 2rpx;
}

.item-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.consume-btn {
  background: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
.modal-content { background: #fff; border-radius: 20rpx; padding: 40rpx; width: 600rpx; }
.modal-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; text-align: center; }
.modal-desc { display: block; font-size: 26rpx; color: #999; margin-bottom: 24rpx; text-align: center; line-height: 1.5; }
.modal-input { border: 1px solid #eee; border-radius: 10rpx; padding: 24rpx; font-size: 32rpx; margin-bottom: 24rpx; width: 100%; box-sizing: border-box; }
.modal-actions { display: flex; gap: 20rpx; }
.btn-cancel, .btn-confirm { flex: 1; padding: 20rpx; border-radius: 40rpx; font-size: 28rpx; text-align: center; }
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-confirm { background: #07c160; color: #fff; }