/* AI 菜谱页 */
.page { padding-bottom: 40rpx; }

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 20rpx 12rpx;
  color: #666;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 20rpx 20rpx;
}

.ingredient {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  min-width: 140rpx;
  position: relative;
}

.ingredient.selected {
  border-color: #07c160;
  background: #f6ffed;
}

.ingredient.selected .name {
  color: #07c160;
  font-weight: 600;
}

.checked-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
}

.selected-count {
  text-align: center;
  font-size: 24rpx;
  color: #07c160;
  margin: -8rpx 0 16rpx;
}

.debug-bar {
  text-align: center;
  font-size: 20rpx;
  color: #ccc;
  margin: 0 0 8rpx;
}

.ingredient .name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.ingredient .qty {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.generate-btn {
  margin: 0 20rpx 20rpx;
  width: auto;
}

.generate-btn.btn-disabled {
  opacity: 0.5;
}

.error-msg {
  text-align: center;
  color: #f5222d;
  font-size: 26rpx;
  margin: 20rpx;
}

.recipe-card {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f5ff;
  color: #1890ff;
}

.tag.taste { background: #fff7e6; color: #fa8c16; }
.tag.time { background: #f6ffed; color: #52c41a; }

.recipe-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.recipe-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.recipe-section { margin-bottom: 20rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.ingredient-item { font-size: 26rpx; color: #666; padding: 4rpx 0; }
.missing-label { color: #faad14; }
.missing-item { color: #faad14; }
.hint { font-size: 22rpx; color: #999; }
.step-item { font-size: 26rpx; color: #333; line-height: 1.6; padding: 6rpx 0; display: block; }