/* AI 菜谱页 */
.page { padding-bottom: 40rpx; }

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 20rpx 12rpx;
  color: #666;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 20rpx 20rpx;
}

.ingredient {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  min-width: 140rpx;
}

.ingredient.selected {
  border-color: #07c160;
  background: #f6ffed;
}

.ingredient .name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.ingredient .qty {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.generate-btn {
  margin: 0 20rpx 20rpx;
  width: auto;
}

.generate-btn[disabled] {
  opacity: 0.5;
}

.error-msg {
  text-align: center;
  color: #f5222d;
  font-size: 26rpx;
  margin: 20rpx;
}

.recipe-card {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.recipe-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.recipe-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.recipe-section { margin-bottom: 20rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.ingredient-item { font-size: 26rpx; color: #666; padding: 4rpx 0; }
.step-item { font-size: 26rpx; color: #333; line-height: 1.6; padding: 6rpx 0; display: block; }