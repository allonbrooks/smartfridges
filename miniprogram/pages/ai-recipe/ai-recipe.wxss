/* AI 菜谱页 */
.page { padding-bottom: 40rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 20rpx 12rpx;
  color: rgb(102, 102, 102);
}
.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 20rpx 20rpx;
}
.ingredient {
  background: rgb(255, 255, 255);
  border: 2rpx solid rgb(238, 238, 238);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  min-width: 140rpx;
  position: relative;
}
.ingredient.selected {
  border-color: rgb(7, 193, 96);
  background: rgb(246, 255, 237);
}
.ingredient.selected .name {
  color: rgb(7, 193, 96);
  font-weight: 600;
}
.checked-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgb(7, 193, 96);
  color: rgb(255, 255, 255);
  font-size: 22rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
}
.debug-bar {
  text-align: center;
  font-size: 20rpx;
  color: rgb(204, 204, 204);
  margin: 0 0 8rpx;
}
.ingredient .name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}
.ingredient .qty {
  display: block;
  font-size: 22rpx;
  color: rgb(153, 153, 153);
  margin-top: 4rpx;
}
.generate-btn {
  margin: 0 20rpx 20rpx;
  width: auto;
}
.generate-btn.btn-disabled {
  opacity: 0.5;
}
.error-msg {
  text-align: center;
  color: rgb(245, 34, 45);
  font-size: 26rpx;
  margin: 20rpx;
}
.recipe-card {
  margin: 0 20rpx 20rpx;
  background: rgb(255, 255, 255);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.recipe-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgb(240, 245, 255);
  color: rgb(24, 144, 255);
}
.tag.taste { background: rgb(255, 247, 230); color: rgb(250, 140, 22); }
.tag.time { background: rgb(246, 255, 237); color: rgb(82, 196, 26); }
.recipe-section { margin-bottom: 20rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.ingredient-item { font-size: 26rpx; color: rgb(102, 102, 102); padding: 4rpx 0; }
.missing-label { color: rgb(250, 173, 20); }
.missing-item { color: rgb(250, 173, 20); }
.hint { font-size: 22rpx; color: rgb(153, 153, 153); }
.step-item { font-size: 26rpx; color: rgb(51, 51, 51); line-height: 1.6; padding: 6rpx 0; display: block; }
.selected-count {
  text-align: center;
  font-size: 24rpx;
  color: rgb(7, 193, 96);
  margin: 0 0 16rpx;
}