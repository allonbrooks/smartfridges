<!-- AI 菜谱 -->
<view class="page">
  <view class="section-title">选择冰箱里的食材（至少3样）</view>

  <view wx:if="{{items.length === 0}}" class="empty-state">
    <text class="icon">🍳</text>
    <text>冰箱里还没有食材，先去添加吧</text>
  </view>

  <view wx:else class="ingredient-grid">
    <view
      class="ingredient {{selectedIds.indexOf(item.id) > -1 ? 'selected' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="toggleItem"
    >
      <text class="name">{{item.name}}</text>
      <text class="qty">{{item.quantity}}{{item.unit || '个'}}</text>
      <text wx:if="{{selectedIds.indexOf(item.id) > -1}}" class="checked-badge">✓</text>
    </view>
  </view>

  <view wx:if="{{selectedIds.length > 0}}" class="selected-count">
    已选 {{selectedIds.length}} 种食材
  </view>

  <!-- debug: 显示已加载食材数量和选中数量 -->
  <view class="debug-bar">
    食材 {{items.length}} 种 · 已选 {{selectedIds.length}} 个
  </view>

  <button
    class="btn-primary generate-btn {{loading || selectedIds.length === 0 ? 'btn-disabled' : ''}}"
    disabled="{{loading || selectedIds.length === 0}}"
    loading="{{loading}}"
    bindtap="generateRecipe"
  >
    {{loading ? '生成中...' : '生成菜谱'}}
  </button>

  <view wx:if="{{error}}" class="error-msg">{{error}}</view>

  <view wx:if="{{recipes && recipes.length > 0}}">
    <view class="recipe-card" wx:for="{{recipes}}" wx:key="title">
      <text class="recipe-title">{{item.title}}</text>
      <view class="recipe-tags">
        <text class="tag">{{item.suitable_for}}</text>
        <text class="tag taste">{{item.taste}}</text>
        <text class="tag time">{{item.estimated_time}}</text>
      </view>

      <block wx:if="{{item.missing_items && item.missing_items.length > 0}}">
        <view class="recipe-section">
          <text class="section-label missing-label">缺少的食材：</text>
          <view wx:for="{{item.missing_items}}" wx:key="*this" class="ingredient-item missing-item">
            <text>- {{item}} <text class="hint">(可加入购物清单)</text></text>
          </view>
        </view>
      </block>

      <view class="recipe-section">
        <text class="section-label">食材清单：</text>
        <view wx:for="{{item.ingredients}}" wx:key="index" class="ingredient-item">
          <text>- {{item.name}} x{{item.quantity}}{{item.unit}} {{item.in_fridge ? '✅' : '❌'}}</text>
        </view>
      </view>

      <view class="recipe-section">
        <text class="section-label">步骤：</text>
        <view wx:for="{{item.steps}}" wx:key="*this">
          <text class="step-item">{{index + 1}}. {{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>